<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Memory" name="4"/>
  <options>
    <a name="gateUndefined" val="isolated"/>
  </options>
  <mappings/>
  <toolbar/>
  <circuit name="sr_latch">
    <a name="circuit" val="sr_latch"/>
    <!-- SR Flip-Flop -->
    <comp lib="4" loc="(120,100)" name="SR Flip-Flop">
      <a name="width" val="1"/>
    </comp>
    <!-- Input pins -->
    <comp lib="0" loc="(30,100)" name="Pin">
      <a name="label" val="S"/>
    </comp>
    <comp lib="0" loc="(30,110)" name="Pin">
      <a name="label" val="R"/>
    </comp>
    <comp lib="0" loc="(30,120)" name="Pin">
      <a name="label" val="CLK"/>
    </comp>
    <!-- Output pins -->
    <comp lib="0" loc="(220,105)" name="Pin">
      <a name="output" val="true"/>
      <a name="label" val="Q"/>
    </comp>
    <comp lib="0" loc="(220,112)" name="Pin">
      <a name="output" val="true"/>
      <a name="label" val="Q_N"/>
    </comp>
    <!-- Wires -->
    <wire from="(30,100)" to="(120,100)"/>
    <wire from="(30,110)" to="(120,101)"/>
    <wire from="(30,120)" to="(120,102)"/>
    <wire from="(120,106)" to="(220,105)"/>
    <wire from="(120,107)" to="(220,112)"/>
  </circuit>
  <circuit name="d_register">
    <a name="circuit" val="d_register"/>
    <!-- 8-bit register -->
    <comp lib="4" loc="(120,100)" name="Register">
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(30,100)" name="Pin">
      <a name="width" val="8"/>
      <a name="label" val="D"/>
    </comp>
    <comp lib="0" loc="(30,101)" name="Pin">
      <a name="label" val="CLK"/>
    </comp>
    <comp lib="0" loc="(30,102)" name="Pin">
      <a name="label" val="EN"/>
    </comp>
    <comp lib="0" loc="(30,103)" name="Pin">
      <a name="label" val="RESET"/>
    </comp>
    <comp lib="0" loc="(220,105)" name="Pin">
      <a name="width" val="8"/>
      <a name="output" val="true"/>
      <a name="label" val="Q"/>
    </comp>
    <wire from="(30,100)" to="(120,100)"/>
    <wire from="(30,101)" to="(120,101)"/>
    <wire from="(30,102)" to="(120,102)"/>
    <wire from="(30,103)" to="(120,103)"/>
    <wire from="(120,105)" to="(220,105)"/>
  </circuit>
  <circuit name="counter_4bit">
    <a name="circuit" val="counter_4bit"/>
    <!-- 4-bit counter -->
    <comp lib="4" loc="(120,100)" name="Counter">
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(30,100)" name="Pin">
      <a name="label" val="CLK"/>
    </comp>
    <comp lib="0" loc="(30,101)" name="Pin">
      <a name="label" val="EN"/>
    </comp>
    <comp lib="0" loc="(30,103)" name="Pin">
      <a name="label" val="RESET"/>
    </comp>
    <comp lib="0" loc="(220,105)" name="Pin">
      <a name="width" val="4"/>
      <a name="output" val="true"/>
      <a name="label" val="COUNT"/>
    </comp>
    <comp lib="0" loc="(220,106)" name="Pin">
      <a name="output" val="true"/>
      <a name="label" val="TERMINAL"/>
    </comp>
    <wire from="(30,100)" to="(120,100)"/>
    <wire from="(30,101)" to="(120,101)"/>
    <wire from="(30,103)" to="(120,104)"/>
    <wire from="(120,105)" to="(220,105)"/>
    <wire from="(120,106)" to="(220,106)"/>
  </circuit>
</project>
